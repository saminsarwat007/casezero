{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "dashboard/",
      "framework": "nextjs"
    },
    "api": {
      "root": "api/",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api", "path": "/$1" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web", "path": "/$1" }
    }
  ]
}
