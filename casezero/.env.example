# CaseZero — copy to .env and fill in. NEVER commit .env.

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Which provider the agents run on. One env var swaps the whole brain.
LLM_PROVIDER=gemini                     # gemini | groq | hunyuan

# Gemini — aistudio.google.com/apikey  (free tier, no card, no WeChat)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq — console.groq.com/keys  (free tier). Used for Batch Storm throughput.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# Hunyuan — stub only. Present so the swap story is real, not hypothetical.
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_MODEL=hunyuan-turbos-latest

# ─── Supabase ─────────────────────────────────────────────────────────────────
# supabase.com -> New project (region: Southeast Asia / Singapore)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> Database -> Connection string -> URI (use the pooler for the API)
DATABASE_URL=
SUPABASE_EVIDENCE_BUCKET=evidence

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Confidence below this is forced to MANUAL_REVIEW. Never raise this for a demo.
CLASSIFIER_CONFIDENCE_FLOOR=0.75

# ─── Intake channels ──────────────────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
COMPLAINTS_EMAIL=
COMPLAINTS_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Shared secret the WorkBuddy agent sends so /intake/workbuddy can't be spoofed.
WORKBUDDY_INTAKE_TOKEN=
TELEGRAM_BOT_TOKEN=

# ─── Web Push (customer PWA) ──────────────────────────────────────────────────
# Generate: python -c "from py_vapid import Vapid01; ..."  or npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:complaints@mybank.com.my

# ─── App ──────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
DASHBOARD_BASE_URL=http://localhost:3000
BANK_NAME=MYBank Berhad
BANK_COMPLAINTS_EMAIL=complaints@mybank.com.my
# Run `python -m api.jobs` as a separate worker; never once per web process.
SUPERVISOR_INTERVAL_MINUTES=15

# ─── Demo controls ────────────────────────────────────────────────────────────
DEMO_REPLAY=0                           # 1 = serve cached LLM responses, zero network
DEMO_SPEED=1.0                          # >1 slows the pipeline so beats are legible
# Public, rate-limited, allow-listed fixture through the real deployed stack.
# Keep off for cloned deployments until the owner intentionally enables it.
PUBLIC_LIVE_DEMO_ENABLED=0
PUBLIC_LIVE_DEMO_DAILY_LIMIT=24
PUBLIC_LIVE_DEMO_HOURLY_LIMIT=2
# Required only when running `python -m api.db.seed_users`. Minimum 12 characters.
DEMO_USER_PASSWORD=
